# ============================================================
# env.sh.example — Copy this to env.sh and fill in your values
# DO NOT commit env.sh — it contains real credentials
# ============================================================

export QUEUE_URL="https://sqs.<region>.amazonaws.com/<account-id>/job-scheduler-main"
export DLQ_URL="https://sqs.<region>.amazonaws.com/<account-id>/job-scheduler-dlq"
export DB_HOST="<your-rds-endpoint>.rds.amazonaws.com"
export DB_NAME="jobscheduler"
export DB_USER="jobadmin"
export DB_PASSWORD="<your-db-password>"
export AWS_REGION="us-east-1"
